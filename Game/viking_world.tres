[sub_resource type="Resource" id="Resource_jubqp"]
script = ExtResource("1_icmae")
island = SubResource("Resource_u5tfx")
coordinates = Vector2(-8223.544, -19207.701)
heading = -0.7440029
scale = Vector3(10, 10, 10)
visibility_range = 6607.4194
acquisition_range = 500.0
description = "Is someone really sailing the seas again? I'm almost starting to envy you, Fallen. Until I remember that this sea is made of Jörmungandr's venom. By the way, I think the serpent has one of the runes."
description_header = "Freyr's thick blond beard hides his smile, but his eyes give it away..."

