[sub_resource type="Resource" id="Resource_x6xlj"]
script = ExtResource("1_rb06u")
island_name = "OdinIsland"
description = "The Fallen... I knew you would come. And now that you're here, it is you who are destined to lead us all out of Helheim and back into the light. Gather three runes to awaken old Sleipnir. Only he can carry us out of this place. I'll give you the first rune. Thor has the second."
header = "Odin's eye gazes at you with stern majesty..."
metadata/_custom_type_script = "uid://wnj3puet57uv"

[sub_resource type="Resource" id="Resource_y53pl"]
script = ExtResource("1_rb06u")
prerequisite = SubResource("Resource_x6xlj")
island_name = "ThorIsland"
description = "Thunder strike me! I haven't seen sailors around here in an eternity! How did you manage not to get lost? Ah, a sun compass... Well, I'll be damned! A long-forgotten technology. Here, take this rune. But the third one... Loki has it. And he won't give it up so easily."
header = "Thor slaps his thigh at the sight of you..."
metadata/_custom_type_script = "uid://wnj3puet57uv"

[sub_resource type="Resource" id="Resource_aimvf"]
script = ExtResource("1_rb06u")
prerequisite = SubResource("Resource_y53pl")
island_name = "LokiIsland"
description = "Well, well! We have visitors! Let me guess. The Fallen have come for the rune? I'm not giving it to you. As long as the gods are trapped here, there can be no more Ragnarök. And I'm perfectly happy with that. Still, you could do me a favor, and I might reconsider. Deliver a gift to Heimdall for me."
header = "Loki's face stretches into an unnaturally wide grin..."
metadata/_custom_type_script = "uid://wnj3puet57uv"

[sub_resource type="Resource" id="Resource_6nnoo"]
script = ExtResource("1_rb06u")
prerequisite = SubResource("Resource_aimvf")
island_name = "HeimdallIsland"
description = "The Fallen... You have a package from Loki? I won't accept anything from him! Wait... Is that my sword? Is that scoundrel trying to make peace? No, to hell with him! I don't trust him. And yet... Give him this."
header = "Heimdall gives you a gloomy look..."
metadata/_custom_type_script = "uid://wnj3puet57uv"

[sub_resource type="Resource" id="Resource_glihj"]
script = ExtResource("1_rb06u")
prerequisite = SubResource("Resource_6nnoo")
island_name = "LokiIsland"
description = "Aha! My fire is finally back where it belongs! It's so cold on this island. So Heimdall does remember how we killed each other. He broke his sword, and I lost my fire. But now... Oh, right, the rune! Jormungandr has it. He would've given it to you anyway. But thanks for your help!"
header = "Loki's face stretches into an unnaturally wide grin..."
metadata/_custom_type_script = "uid://wnj3puet57uv"

[sub_resource type="Resource" id="Resource_0egv3"]
script = ExtResource("1_rb06u")
island_name = "TailIsland"
description = "You feel the gaze of the gigantic monster upon you. For a moment, an icy terror grips you, leaving you paralyzed. But you summon your courage and take the rune resting on the tip of Jörmungandr's tail. The serpent slowly turns away."
header = "You arrive to Jörmungandr's tail."
metadata/_custom_type_script = "uid://wnj3puet57uv"

[sub_resource type="Resource" id="Resource_ujv35"]
script = ExtResource("1_rb06u")
prerequisite = SubResource("Resource_0egv3")
island_name = "SleipnirIsland"
description = "\"You place the runestones into the iron sockets on the horse's neck, and the ancient mechanisms inside begin to grind and creak. The air trembles, filled with magic. A thousand years of dust and rust fall from its mighty body, churning the sea around it into foam.

Odin's steel steed has awakened.

Now you, along with all the fallen mortals and gods, can finally return to Midgard, the world of the living, and see with your own eyes how it has changed since Ragnarök.\""
header = "You arrived to Sleipnir."
metadata/_custom_type_script = "uid://wnj3puet57uv"

