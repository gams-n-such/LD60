[sub_resource type="Resource" id="Resource_fussg"]
script = ExtResource("1_icmae")
island = SubResource("Resource_7lotx")
coordinates = Vector2(-11903.767, 1475.664)
heading = -0.7440029
scale = Vector3(10, 10, 10)
visibility_range = 7911.2256
acquisition_range = 500.0
description = "\"Well, well! We have visitors! Let me guess. The Fallen have learned to navigate by the Sun and dared to venture out to sea? How clever! I'm truly impressed. 

By the way, if you happen to meet that fool Heimdall... give him my warmest regards.\""
description_header = "Loki's face stretches into an unnaturally wide grin..."

[sub_resource type="Resource" id="Resource_1hv7y"]
script = ExtResource("2_icmae")
name = "HeimdallIsland"
scene = ExtResource("2_nq65h")
map_sprite = SubResource("PlaceholderTexture2D_v6u60")
map_sprite_scale = 10.0

[sub_resource type="Resource" id="Resource_0hpey"]
script = ExtResource("1_icmae")
island = SubResource("Resource_1hv7y")
coordinates = Vector2(9965.031, 11355.9375)
heading = -0.7440029
scale = Vector3(10, 10, 10)
visibility_range = 6954.4989013671875
acquisition_range = 500.0
description = "\"The Fallen... You have seen Asgard, just as I have... Its sky was so different from this one. There are no rainbows in Helheim.

I'm here because of Loki... It was foretold that he would kill me. Why? Why was I destined to fall to a scoundrel like him?

He has no place among us gods.\""
description_header = "Heimdall gives you a gloomy look..."

