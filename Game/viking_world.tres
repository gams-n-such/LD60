[sub_resource type="Resource" id="Resource_oacub"]
script = ExtResource("1_icmae")
island = SubResource("Resource_7gpj0")
coordinates = Vector2(-18639.227, -10434.898)
heading = -0.7440029
scale = Vector3(10, 10, 10)
visibility_range = 6792.3419189453125
acquisition_range = 500.0
description = "The prophecies of Ragnarök never said we'd end up imprisoned in Helheim. Even the giant Jörmungandr is a prisoner here, just like us. But perhaps he's also the key. I've heard he has some important rune."
description_header = "Tyr gazes thoughtfully at the horizon..."

[sub_resource type="Resource" id="Resource_ntpek"]
script = ExtResource("2_icmae")
name = "ThorIsland"
scene = ExtResource("2_nq65h")
map_sprite = SubResource("PlaceholderTexture2D_v6u60")
map_sprite_scale = 10.0

[sub_resource type="Resource" id="Resource_3q5mt"]
script = ExtResource("1_icmae")
island = SubResource("Resource_ntpek")
coordinates = Vector2(-5713.0723, -7665.9004)
heading = -0.7440029
scale = Vector3(10, 10, 10)
visibility_range = 8765.664
acquisition_range = 500.0
description = "Thunder strike me! I haven't seen sailors around here in an eternity! How did you manage not to get lost? Ah, a sun compass... Well, I'll be damned! A long-forgotten technology."
description_header = "Thor slaps his thigh at the sight of you..."

[sub_resource type="Resource" id="Resource_u5tfx"]
