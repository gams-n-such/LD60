[sub_resource type="Resource" id="Resource_ax8pg"]
script = ExtResource("1_icmae")
island = SubResource("Resource_rb06u")
coordinates = Vector2(2020.5231, -13380.366)
heading = -0.7440029
scale = Vector3(10, 10, 10)
visibility_range = 8035.4229736328125
acquisition_range = 500.0
description = "The Fallen... I knew you would come. And now that you're here, it is you who are destined to lead us all out of Helheim and back into the light. Gather three runes to awaken old Sleipnir. Only he can carry us out of this place."
description_header = "Odin's eye gazes at you with stern majesty..."

[sub_resource type="Resource" id="Resource_n3tos"]
script = ExtResource("2_icmae")
name = "SleipnirIsland"
scene = ExtResource("4_ax8pg")
map_sprite = SubResource("PlaceholderTexture2D_v6u60")
map_sprite_scale = 10.0

[sub_resource type="Resource" id="Resource_sh1nk"]
script = ExtResource("1_icmae")
island = SubResource("Resource_n3tos")
coordinates = Vector2(8783.761, -7682.7427)
heading = -0.7440029
scale = Vector3(10, 10, 10)
visibility_range = 6792.3419189453125
acquisition_range = 500.0
description = "You gaze upon the colossal figure of the horse, its iron body ravaged by time. Can this giant be awakened, or will it sleep forever?"
description_header = "You arrive at Sleipnir island."

[sub_resource type="Resource" id="Resource_7gpj0"]
script = ExtResource("2_icmae")
name = "TurIsland"
